// decoders.ino -- STAGE 2: two ways to turn the muscle signals into one gesture guess.

// ---- Rule decoder: first match wins, in this order (from Max's notes) ----
uint8_t ruleDecode(bool flexor, bool extensor, bool thumb, bool index) {
  if (!flexor && !extensor && !thumb && !index)       return P_REST;
  if (extensor && !flexor && !thumb)                  return P_OPEN;
  if (flexor && thumb && !extensor && !index)         return P_FIST;
  if (thumb && !flexor && !extensor && !index)        return P_PINCH;
  if (flexor && index && !extensor)                   return P_POINT;
  return P_INVALID;                                   // anything else = no valid gesture
}

